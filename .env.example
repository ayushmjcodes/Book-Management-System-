# Copy this file to .env and fill in your own values.
# Never commit your real .env file to version control.

# A long, random string used to sign session cookies.
SECRET_KEY=change-this-to-a-long-random-secret-key

# PostgreSQL connection string: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/notes_db

# How long (in seconds) a login session stays valid. 86400 = 24 hours.
SESSION_LIFETIME_SECONDS=86400

FLASK_ENV=development
